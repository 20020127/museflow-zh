{
  "manifest_version": 3,
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';" },
  "name": "26Flow (MuseFlow 中文版)",
  "version": "0.5.2",
  "description": "26Flow 可视化节点工作流画布，基于当前浏览器已登录的 Muse.ai 会话进行图文与视频生成。",
  "action": { "default_title": "打开 26Flow 画布", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://muse.ai/*", "https://*.muse.ai/*", "https://raw.githubusercontent.com/bynne2602/museflow/*"],
  "content_scripts": [{
    "matches": ["https://muse.ai/*", "https://*.muse.ai/*"],
    "js": ["muse-bridge.js"],
    "run_at": "document_idle"
  }]
}
