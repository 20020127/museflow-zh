{
  "format": "26flow-workflow",
  "version": 1,
  "appVersion": "0.5.2",
  "workflow": {
    "nodes": [
      {
        "id": "neg-prompt",
        "type": "negativePrompt",
        "x": 80,
        "y": 60,
        "data": {
          "customName": "负向提示词 (全局过滤)",
          "text": "low quality, blurry, deformed limbs, bad anatomy, extra paws, scary, horror, creepy, ugly, glitch, watermark, text, signature"
        }
      },
      {
        "id": "prompt-img-1",
        "type": "prompt",
        "x": 80,
        "y": 280,
        "data": {
          "customName": "分镜1 首帧定妆提示词",
          "sceneLabel": "镜头1: 首帧参考",
          "text": "Pixar 3D animation style, adorable golden retriever puppy wearing a tiny festive pumpkin costume and cute witch hat, holding an orange pumpkin candy bucket in mouth, standing at the cozy wooden doorstep of a fairy tale cottage at dusk, warm glowing porch lanterns, colorful fallen autumn leaves, looking up at the doorbell with big innocent sparkling eyes, highly detailed fur, soft cinematic lighting, 8k render."
        }
      },
      {
        "id": "gen-img-1",
        "type": "generateImage",
        "x": 400,
        "y": 280,
        "data": {
          "customName": "分镜1 首帧定妆图",
          "model": "muse-image",
          "size": "16:9",
          "status": "idle"
        }
      },
      {
        "id": "prompt-vid-1",
        "type": "prompt",
        "x": 80,
        "y": 560,
        "data": {
          "customName": "分镜1 视频动态提示词",
          "sceneLabel": "镜头1: 小狗按门铃",
          "text": "Pixar 3D animated video, 16:9. The adorable golden retriever puppy in pumpkin costume wags its fluffy tail enthusiastically at the doorstep. It gently raises its front paw to tap the brass doorbell, then sits down obediently with ears twitching, big sparkling eyes looking up at the closed door in joyful anticipation. Cozy glowing lantern light, gentle autumn breeze swaying the leaves, smooth cinematic camera motion."
        }
      },
      {
        "id": "gen-vid-1",
        "type": "generateVideo",
        "x": 400,
        "y": 560,
        "data": {
          "customName": "分镜1 视频 (按门铃 5秒)",
          "sceneLabel": "镜头1: 小狗按门铃",
          "model": "muse-video",
          "size": "16:9",
          "duration": 5,
          "continuity": false,
          "status": "idle"
        }
      },
      {
        "id": "prompt-vid-2",
        "type": "prompt",
        "x": 740,
        "y": 280,
        "data": {
          "customName": "分镜2 视频动态提示词",
          "sceneLabel": "镜头2: 开门送糖果",
          "text": "Pixar 3D animated video, 16:9. CONTINUITY: The wooden cottage door creaks open warmly with golden light spilling onto the porch. A kind human hand reaches out holding delicious colorful wrapped candies and gently drops them into the puppy pumpkin bucket. The golden puppy happily wiggles its whole body, panting with joy, tail wagging like a propeller, eyes shining brightly."
        }
      },
      {
        "id": "gen-vid-2",
        "type": "generateVideo",
        "x": 1060,
        "y": 280,
        "data": {
          "customName": "分镜2 视频 (送糖果 5秒)",
          "sceneLabel": "镜头2: 开门送糖果",
          "model": "muse-video",
          "size": "16:9",
          "duration": 5,
          "continuity": true,
          "status": "idle"
        }
      },
      {
        "id": "prompt-vid-3",
        "type": "prompt",
        "x": 740,
        "y": 560,
        "data": {
          "customName": "分镜3 视频动态提示词",
          "sceneLabel": "镜头3: 叼着糖果欢快奔跑",
          "text": "Pixar 3D animated video, 16:9. CONTINUITY: The cute puppy proudly picks up its full pumpkin candy bucket by the handle. It turns back toward the camera to give a heartwarming, cheerful puppy head-tilt smile, then turns and happily trots down the cobblestone garden path illuminated by warm streetlamps, leaves fluttering around its tiny paws, joyful festival atmosphere."
        }
      },
      {
        "id": "gen-vid-3",
        "type": "generateVideo",
        "x": 1060,
        "y": 560,
        "data": {
          "customName": "分镜3 视频 (叼糖奔跑 5秒)",
          "sceneLabel": "镜头3: 叼着糖果欢快奔跑",
          "model": "muse-video",
          "size": "16:9",
          "duration": 5,
          "continuity": true,
          "status": "idle"
        }
      },
      {
        "id": "timeline-main",
        "type": "timeline",
        "x": 1400,
        "y": 280,
        "data": {
          "customName": "视频时间线 (总计 15秒)",
          "clipOrder": [
            "gen-vid-1",
            "gen-vid-2",
            "gen-vid-3"
          ],
          "durations": {
            "gen-vid-1": 5,
            "gen-vid-2": 5,
            "gen-vid-3": 5
          }
        },
        "_timelineEdges": [
          {
            "id": "e-time1",
            "source": "gen-vid-1",
            "sourcePort": "video",
            "target": "timeline-main",
            "targetPort": "clip1"
          },
          {
            "id": "e-time2",
            "source": "gen-vid-2",
            "sourcePort": "video",
            "target": "timeline-main",
            "targetPort": "clip2"
          },
          {
            "id": "e-time3",
            "source": "gen-vid-3",
            "sourcePort": "video",
            "target": "timeline-main",
            "targetPort": "clip3"
          }
        ]
      },
      {
        "id": "preview-main",
        "type": "preview",
        "x": 1400,
        "y": 560,
        "data": {
          "customName": "最终成片预览",
          "asset": null
        }
      }
